[Unit]
Description=Run the ESFA hours database backup daily

[Timer]
# Run every day at 02:30 Tehran time (the server runs on UTC).
# Persistent=true means a missed run (e.g. machine was off) fires as soon
# as the machine is back up.
OnCalendar=*-*-* 02:30:00 Asia/Tehran
Persistent=true
Unit=esfa_backup.service

[Install]
WantedBy=timers.target
