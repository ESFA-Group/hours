[Unit]
Description=ESFA hours database backup (tiered SQLite snapshot)
After=network.target

[Service]
Type=oneshot
User=deploy
Group=deploy
# Override these via systemd if your paths differ:
Environment=ESFA_DB_PATH=/opt/hours/data/db.sqlite3
Environment=ESFA_BACKUP_DIR=/opt/hours/backups
ExecStart=/bin/bash /opt/hours/system_files/db_backup.sh

[Install]
WantedBy=multi-user.target
